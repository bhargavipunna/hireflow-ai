# --- LLM ---
# Ollama model tag (must be pulled locally via `ollama pull <tag>`).
OLLAMA_MODEL=qwen3:8b

# --- RAG / Vector DB ---
DATA_DIR=data
CHROMA_DIR_REL=chroma
COLLECTION_NAME=user_profile
TOP_K=5

# --- Resume source ---
# Preferred free/local workflow: put your master LaTeX resume here.
MASTER_RESUME_TEX_PATH=data/resume/resume.tex
# Optional direct .tex URL. If set, it is downloaded into data/resume/.
MASTER_RESUME_TEX_URL=

# --- Matching ---
# Minimum cosine-similarity*100 score for a job to qualify for artifacts.
MATCH_THRESHOLD=65
# How many top jobs to surface in summaries.
TOP_MATCHES=10

# --- Scraper behavior ---
SCRAPER_TIMEOUT=20
SCRAPER_RETRIES=3
SCRAPER_BACKOFF=1.5
SCRAPER_CONCURRENCY=5
# Optional: comma-separated source stems to enable (default: all).
# Example: SCRAPER_ENABLED_SOURCES=wellfound,internshala,remote
SCRAPER_ENABLED_SOURCES=

# --- Outbound actions (Phase 1: always draft-only) ---
# These flags are intentionally False. Phase 1 never sends email or
# submits applications - it only writes draft files.
SEND_EMAILS=false
AUTO_APPLY=false
